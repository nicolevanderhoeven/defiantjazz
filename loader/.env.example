# Copy to loader/.env and fill in. loader/.env is git-ignored; never commit a real token.
#
# Grafana Cloud: find these on your stack's "OpenTelemetry" tile
# (grafana.com > your stack > Details / Configure OpenTelemetry).
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=123456
# An access policy token with logs:write, metrics:write and traces:write.
GRAFANA_API_TOKEN=glc_...

# Optional: after loading, the loader asks Loki how many of the last 2 hours' log
# lines it stored and warns if any are missing (older lines show up hours later).
# Find these on your stack's "Loki" tile (grafana.com > your stack > Loki > Details):
# the URL and the user (a number, not the OTLP instance ID). The token needs logs:read.
# Leave them unset to skip the check.
# GRAFANA_LOKI_URL=https://logs-prod-<n>.grafana.net
# GRAFANA_LOKI_USER=123456
# GRAFANA_LOKI_READ_TOKEN=glc_...

# Optional: your stack's Grafana URL, so the dashboard and Explore links the loader
# prints after a load (pinned to that load's window and case_run) are ready to open.
# GRAFANA_URL=https://<your-stack>.grafana.net

# Optional: hours of log history to send to Grafana Cloud (default 167; same as --cloud-log-hours).
# Cloud Loki rejects lines more than 7 days old.
# DJ_CLOUD_LOG_HOURS=167

# Local stack overrides (defaults shown; only needed if you changed ports).
# LOCAL_LOKI_OTLP=http://localhost:3100/otlp/v1/logs
# LOCAL_PROMETHEUS_OTLP=http://localhost:9090/api/v1/otlp/v1/metrics
# LOCAL_TEMPO_OTLP=http://localhost:4318/v1/traces
