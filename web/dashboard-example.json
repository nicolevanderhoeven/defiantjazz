{
  "title": "The Defiant Jazz Incident",
  "uid": "defiantjazz-game",
  "description": "Play The Defiant Jazz Incident beside its telemetry. The game panel needs the innius-video-panel plugin; set its iframe URL to where web/ is hosted.",
  "tags": [
    "defiantjazz",
    "game"
  ],
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "case_run",
        "label": "Load (case_run)",
        "description": "Which load to show. The newest load in the time range comes first; the loader prints a link pinned to each load.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(target_info{service_namespace=\"kipsake-sleep-floor\"},case_run)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(target_info{service_namespace=\"kipsake-sleep-floor\"},case_run)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 2,
        "includeAll": false,
        "multi": false,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "innius-video-panel",
      "title": "Play The Defiant Jazz Incident",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "videoType": "iframe",
        "iframeURL": "https://example.com/defiantjazz/web/?theme=dark",
        "autoPlay": false,
        "loop": false,
        "customBackground": false,
        "geolocate": false
      },
      "targets": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sleep Floor log lines by source",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "expr": "sum by (service_name) (count_over_time({service_namespace=\"kipsake-sleep-floor\"} | case_run=\"$case_run\" [$__auto]))",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Sleep Floor logs",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "queryType": "range",
          "expr": "{service_namespace=\"kipsake-sleep-floor\"} | case_run=\"$case_run\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false
      }
    }
  ]
}
