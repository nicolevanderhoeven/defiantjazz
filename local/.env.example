# Copy to local/.env (git-ignored) to set the Grafana admin login.
# Only applied when Grafana's data volume is first created; see README to change it later.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: require MCP clients to send this as a bearer token.
# MCP_SERVER_TOKEN=

# Optional: move a port if something else on your machine already uses it.
# DJ_GAME_PORT=8080
# DJ_GRAFANA_PORT=3000
# DJ_MCP_PORT=8000

# Optional, off by default: where the game's "Add my score to the public leaderboard" button sends your score
# (an https:// Grafana Frontend Observability collector URL, https://faro-collector-.../collect/<app key>).
# This is the only thing in the local stack that talks to Grafana Cloud, and only after you click the button.
# Leave it unset and the button isn't shown. The collector also has to allow the game's origin (http://localhost:8080).
# DJ_LEADERBOARD_URL=
